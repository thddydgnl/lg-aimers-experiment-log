  "hypothesis": "The direct current-season Bayesian update is directionally useful but its optimal strength changes by row and season. A shallow gate fitted only on the immediately previous completed season can learn stable row-local regions and blend strengths, then transfer unchanged one year forward.",
  "competition_scope": {
    "allowed_inputs": [
      "official train.csv rows from completed seasons",
      "frozen M3 probability",
      "direct current-season update probability and its row-local reconstructed n_current/s_current",
      "official row-local pre-pitch columns"
    ],
    "forbidden": [
      "evaluation-row aggregation, order, count, or distribution",
      "2025 TrackMan",
      "future labels",
      "external data or APIs",
      "automatic DACON submission"
    ],
    "evaluation_inference_is_row_independent": true
  },
  "components": {
    "parent": "v5 honest/published M3 anchor for the target fold",
    "alternate": "V5_DIRECT_SEASON_UPDATE anchor_posterior with k_R=500; F is never changed",
    "component_count_for_contract": 2,
    "nonnegative_convex_formula": "parent + gate_weight(row) * (alternate - parent), with 0 <= gate_weight <= 1"
  },
  "temporal_protocol": {
    "source_fit_season": 2020,
