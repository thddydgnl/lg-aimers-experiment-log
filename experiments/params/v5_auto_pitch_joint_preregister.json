{
  "experiment_id": "V5_AUTO_PITCH_JOINT_OUTCOME_V1",
  "created_at_kst": "2026-08-22",
  "status": "locked_before_source_training",
  "hypothesis": "The tagged fine-pitch joint direction was significantly positive on R in both source years. The official auto pitch type has higher held-out selection accuracy and comparable privileged control headroom, so using it consistently as both the OOF auxiliary task and joint outcome label may strengthen the same coherent marginal without label-source mixing.",
  "source_protocol": {
    "years": [2020, 2021],
    "parent": "exact C",
    "selection_route": "R",
    "ranking": "maximize minimum R gain, then minimum full gain, then mean R gain, then prefer smaller gamma",
    "top_level_blend_grid": [0.1, 0.25, 0.5, 0.75, 1.0],
    "bootstrap_iterations": 2000,
    "gate": {
      "minimum_R_gain_each_year": 25.0,
      "minimum_full_gain_each_year": 0.0,
      "R_pitcher_cluster_95_ci_lower_positive_each_year": true,
      "full_pitcher_cluster_95_ci_lower_positive_each_year": true
    },
    "on_fail": "Close without reading 2022, 2023, or 2024 candidate metrics.",
    "on_pass": "Lock gamma and run fresh 2022/2023 development folds."
  },
  "candidate": {
    "model": "catboost_auto_pitch_joint",
    "params": "experiments/params/v5_auto_pitch_joint_catboost.json",
    "outcome_scheme": "reverse_any",
    "fine_pitch_types": ["Fastball", "Slider", "Curveball", "ChangeUp", "Splitter", "Sinker", "Cutter", "Other"],
    "features": ["base", "e14", "platoon", "hand_matchup", "e14_hand_cells", "e14_count_cells", "e14_type_count_cells", "trackman_rich", "batter_e14", "batter_middle_e14", "pitchmix_e14", "auto_pitch_latent"],
    "drop_features": ["pitcher_id"],
    "prediction": "sum all success|pitch=<auto type> probabilities",
    "current_pitch_type_at_inference": false,
    "current_pitch_trackman_at_inference": false,
    "row_independent_inference": true
  },
  "semantic_gate": {
    "minimum_history_auto_label_coverage_each_year": 0.5,
    "minimum_success_joint_classes_each_year": 7,
    "all_eight_types_required_each_year": true
  },
  "data_contract": {
    "official_open_data_only": true,
    "external_data_or_api": false,
    "test_rows_read": false,
    "future_labels_or_future_trackman": false,
    "automatic_dacon_submission": false
  },
