{
  "experiment_id": "V5_CONDITIONAL_PHYSICS_INTEGRATION_SIGNAL_V1",
  "created_at_kst": "2026-08-22",
  "status": "locked_before_signal_generation",
  "hypothesis": "Historical physics-teacher scores failed to transfer because they retained the historical pitch context. Re-score each pitcher's completed-history repertoire under the current row's balls, strikes, outs, pitcher hand, and batter hand, then integrate over that repertoire. This approximates E[control | current context, historical repertoire] without current-row TrackMan.",
  "linkage_source": {
    "method": "locked target-free exact plus conservative partial TrackMan linkage",
    "artifacts": {
      "2020": "experiments/results/predictions/v5_partial_trackman_linkage_history_to_2020.npz",
      "2021": "experiments/results/predictions/v5_partial_trackman_linkage_history_to_2021.npz"
    },
    "evidence": "experiments/results/v5_partial_trackman_linkage_source.json"
  },
  "teacher_models": {
    "control_features": [
      "balls_before",
      "strikes_before",
      "outs_before",
      "pitcher_hand",
      "batter_hand",
      "pitch_type_group",
      "tagged_pitch_type",
      "auto_pitch_type"
    ],
    "physics_features_added": [
      "rel_speed",
      "spin_rate",
      "induced_vert_break",
      "horz_break",
      "extension",
      "rel_height",
      "rel_side",
      "zone_speed"
    ],
    "estimator": "exact deterministic LightGBM recipe from V5_PRIVILEGED_TRACKMAN_TEACHER_FEASIBILITY_V1",
    "identifier_features": false
  },
  "integration": {
    "validation_context": [
      "balls_before",
      "strikes_before",
      "outs_before",
      "pitcher_hand",
      "batter_hand"
    ],
    "maximum_repertoire_pitches_per_context": 64,
    "sampling": "deterministic evenly-spaced rows after stable season/row_id ordering",
    "fallback_order": ["pitcher_id", "pitcher_team_id x pitcher_hand", "pitcher_hand"],
    "signals": {
      "integrated_full": "mean physics-teacher probability",
      "integrated_control": "mean control-teacher probability",
      "physics_delta": "mean physics-teacher probability minus mean control-teacher probability"
    }
  },
  "source_cutoffs": {
